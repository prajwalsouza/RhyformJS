{
  "name": "rhyform",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-first mathematical animation with direct SVG transforms",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "check:release": "node scripts/check-release.mjs && npm run check:dist",
    "test": "npm run build && node tests/run.mjs",
    "demo": "python3 -m http.server 8769 --bind 127.0.0.1"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "svgpath": "2.6.0"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "eslint-scope": "8.4.0",
    "mathjax": "3.2.2",
    "playwright": "1.63.0"
  },
  "license": "MIT"
}
